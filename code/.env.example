# Salin berkas ini menjadi `.env` bila lokasi folder dataset Anda berbeda
# dari susunan bawaan (lihat compose.yaml). Docker Compose otomatis membaca
# berkas `.env` di folder yang sama dengan compose.yaml.
#
# Bawaan (tanpa .env), relatif terhadap folder Dataset/code:
#   DATASET_SOURCE=../Labeled
#   DATASET_OUTPUT=../augmented dataset

# Folder dataset asli berisi subfolder kelas 0-9 (di-mount read-only).
DATASET_SOURCE=../Labeled

# Folder tujuan hasil augmentasi (di-mount read-write).
DATASET_OUTPUT=../augmented dataset
